<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>meldog_perception</name>
  <version>0.0.0</version>
  <description>Person detection and re-identification for the Meldog quadruped robot (YOLO + OSNet, ONNX Runtime / TensorRT)</description>
  <maintainer email="tymoteuszpiwonski@gmail.com">tymon</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_components</depend>
  <depend>sensor_msgs</depend>
  <depend>vision_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>libopencv-dev</depend>

  <!-- Inference backends have no rosdep keys, install them manually (see README):
         ONNX Runtime (CMake option MELDOG_HAS_ONNXRUNTIME, default ON)  - /opt/onnxruntime, installed in .devcontainer/Dockerfile
         CUDA + TensorRT (CMake option MELDOG_HAS_TENSORRT, default OFF) - shipped with JetPack on the Jetson -->

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>realsense2_camera</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
